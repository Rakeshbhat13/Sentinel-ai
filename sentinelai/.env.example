# SentinelAI configuration
# Copy to .env and fill in values.

# Optional: Redis URL for session state. Falls back to in-memory dict.
# REDIS_URL=redis://localhost:6379/0

# Optional: Gemini API key for the LLM judge fallback tier.
# Without this, the mock judge is used (works fine for demos).
# GEMINI_API_KEY=your-key-here

# SQLite path for the audit trail (default: sentinelai.db in cwd)
# SQLITE_PATH=sentinelai.db
