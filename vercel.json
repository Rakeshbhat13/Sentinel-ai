{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "sentinel-ai/backend",
            "framework": "fastapi"
        },
        "dashboard": {
            "root": "sentinelai/dashboard",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "dashboard"
            }
        }
    ]
}